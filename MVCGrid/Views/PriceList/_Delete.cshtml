@model DentalCareManagmentSystem.Application.DTOs.PriceListItemDto

<!-- This partial is loaded into a modal-body, NO modal-header or modal-footer -->
<div class="alert alert-warning">
    <i class="fas fa-exclamation-triangle"></i>
    <strong>Warning!</strong> This action cannot be undone.
</div>

<form id="deleteForm" method="post" action="@Url.Action("DeleteConfirmed", "PriceList")">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" value="@Model.Id" />

    <div class="mb-3">
        <h5>Are you sure you want to delete this service?</h5>
    </div>

    <div class="card bg-light">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-4">
                    <i class="fas fa-tooth"></i> Service Name:
                </dt>
                <dd class="col-sm-8">
                    <strong>@Model.Name</strong>
                </dd>

                <dt class="col-sm-4">
                    <i class="fas fa-dollar-sign"></i> Price:
                </dt>
                <dd class="col-sm-8">
                    <strong class="text-success">$@Model.DefaultPrice.ToString("N2")</strong>
                </dd>

                <dt class="col-sm-4">
                    <i class="fas fa-info-circle"></i> Status:
                </dt>
                <dd class="col-sm-8">
                    @if (Model.IsActive)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactive</span>
                    }
                </dd>
            </dl>
        </div>
    </div>

    <div class="alert alert-info mt-3 mb-0">
        <i class="fas fa-info-circle"></i>
        <strong>Note:</strong> This is a soft delete. The service will be marked as inactive and won't appear in treatment plans, but historical data will be preserved.
    </div>

    <!-- Footer Buttons -->
    <div class="d-flex justify-content-end gap-2 mt-4">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
            <i class="fas fa-times"></i> Cancel
        </button>
        <button type="submit" class="btn btn-danger">
            <i class="fas fa-trash"></i> Delete Service
        </button>
    </div>
</form>
