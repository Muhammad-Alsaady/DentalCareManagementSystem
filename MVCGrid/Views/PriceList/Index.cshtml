@model List<DentalCareManagmentSystem.Application.DTOs.PriceListItemDto>

@{
    ViewData["Title"] = "Service Price List";
}

<div class="container-fluid">
    <!-- Header -->
    <div class="row mb-3">
        <div class="col-md-12">
            <div class="d-flex justify-content-between align-items-center">
                <h2><i class="fas fa-dollar-sign"></i> Service Price List</h2>
                <div>
                    <button class="btn btn-success" onclick="showCreate()">
                        <i class="fas fa-plus"></i> Add Service
                    </button>
                    <button class="btn btn-outline-primary" onclick="refreshGrid()">
                        <i class="fas fa-sync"></i> Refresh
                    </button>
                </div>
            </div>
            <hr />
        </div>
    </div>

    <!-- Search -->
    <div class="row mb-3">
        <div class="col-md-12">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="row align-items-end">
                        <div class="col-md-9">
                            <label class="form-label fw-bold">
                                <i class="fas fa-search"></i> Search by Service Name:
                            </label>
                            <div class="input-group">
                                <input type="text" id="searchInput" class="form-control"
                                       placeholder="Search services..."
                                       onkeypress="if(event.keyCode==13) performSearch()" />
                                <button class="btn btn-primary" onclick="performSearch()">
                                    <i class="fas fa-search"></i> Search
                                </button>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <button class="btn btn-secondary w-100" onclick="clearSearch()">
                                <i class="fas fa-times"></i> Clear Search
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Grid -->
    <div class="row">
        <div class="col-md-12">
            <div class="card shadow-sm">
                <div class="card-body" id="gridContainer">
                    @await Html.PartialAsync("_PriceListGrid", Model)
                </div>
            </div>
        </div>
    </div>
</div>

<!-- NO LOCAL MODAL - Using Global Modal from _Layout -->

@section Scripts {
    <script>
        $(document).ready(function () {
            // Listen for modal success to refresh grid
            $(document).on('modalSuccess', function(event, response) {
                console.log('Service saved successfully');
                refreshGrid();
            });
        });

        // Show Create Form - Uses Global Modal
        function showCreate() {
            UIHelpers.loadModal(
                '@Url.Action("Create", "PriceList")',
                '<i class="fas fa-plus"></i> Add New Service'
            );
        }

        // Show Edit Form - Uses Global Modal
        function showEdit(id) {
            UIHelpers.loadModal(
                '@Url.Action("Edit", "PriceList")/' + id,
                '<i class="fas fa-edit"></i> Edit Service'
            );
        }

        // Show Delete Confirmation - Uses Global Modal
        function showDelete(id) {
            UIHelpers.loadModal(
                '@Url.Action("Delete", "PriceList")/' + id,
                '<i class="fas fa-trash"></i> Delete Service'
            );
        }

        // Perform Search
        function performSearch() {
            var searchTerm = $('#searchInput').val();
            
            UIHelpers.reloadGridPartial(
                '#gridContainer',
                '@Url.Action("GetPriceListGrid", "PriceList")',
                { searchString: searchTerm }
            );
        }

        // Clear Search
        function clearSearch() {
            $('#searchInput').val('');
            refreshGrid();
        }

        // Refresh Grid
        function refreshGrid() {
            UIHelpers.reloadGridPartial(
                '#gridContainer',
                '@Url.Action("GetPriceListGrid", "PriceList")'
            );
        }
    </script>
}
