@using DentalCareManagmentSystem.Domain.Enums
@model DentalManagementSystem.Models.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="display-4">
                <i class="fas fa-tachometer-alt me-3"></i> Home
            </h1>
            <p class="lead text-muted">Welcome to Dental Care Management System</p>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card bg-primary text-white shadow">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-subtitle mb-2 opacity-75">Total Patients</h6>
                            <h2 class="card-title mb-0">@Model.TotalPatients</h2>
                        </div>
                        <div>
                            <i class="fas fa-users fa-3x opacity-50"></i>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-0">
                    <a href="#recentPatients" class="text-white text-decoration-none">
                        View Patients <i class="fas fa-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card bg-success text-white shadow">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-subtitle mb-2 opacity-75">Today's Appointments</h6>
                            <h2 class="card-title mb-0">@Model.TodayAppointments</h2>
                        </div>
                        <div>
                            <i class="fas fa-calendar-check fa-3x opacity-50"></i>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-0">
                    <a href="#todaysAppointments" class="text-white text-decoration-none">
                        View Today's <i class="fas fa-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card bg-warning text-white shadow">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-subtitle mb-2 opacity-75">Pending Appointments</h6>
                            <h2 class="card-title mb-0">@Model.PendingAppointments</h2>
                        </div>
                        <div>
                            <i class="fas fa-clock fa-3x opacity-50"></i>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-0">
                    <a href="#allAppointments" class="text-white text-decoration-none">
                        View All <i class="fas fa-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card bg-info text-white shadow">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-subtitle mb-2 opacity-75">This Month Revenue</h6>
                            <h2 class="card-title mb-0">$@Model.TotalRevenueThisMonth</h2>
                        </div>
                        <div>
                            <i class="fas fa-dollar-sign fa-3x opacity-50"></i>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-0">
                    <small class="text-white-50">Outstanding: $@Model.OutstandingBalance</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-bolt me-2"></i>Quick Actions
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-2 mb-3">
                            <button onclick="showCreate()" class="btn btn-outline-primary btn-lg w-100">
                                <i class="fas fa-plus-circle fa-2x mb-2 d-block"></i>
                                New Appointment
                            </button>
                        </div>
                        <div class="col-md-2 mb-3">
                            <a asp-controller="PatientAppointment" asp-action="Index" class="btn btn-outline-success btn-lg w-100">
                                <i class="fas fa-calendar-alt fa-2x mb-2 d-block"></i>
                                All Appointments
                            </a>
                        </div>
                        <div class="col-md-2 mb-3">
                            <a href="#todaysAppointments" class="btn btn-outline-info btn-lg w-100">
                                <i class="fas fa-calendar-day fa-2x mb-2 d-block"></i>
                                Today's Schedule
                            </a>
                        </div>
                        <div class="col-md-2 mb-3">
                            <a href="#recentPatients" class="btn btn-outline-warning btn-lg w-100">
                                <i class="fas fa-users fa-2x mb-2 d-block"></i>
                                Recent Patients
                            </a>
                        </div>
                        <div class="col-md-2 mb-3">
                            <a href="#allAppointments" class="btn btn-outline-secondary btn-lg w-100">
                                <i class="fas fa-list fa-2x mb-2 d-block"></i>
                                View All
                            </a>
                        </div>
                        <div class="col-md-2 mb-3">
                            <button class="btn btn-outline-danger btn-lg w-100" onclick="refreshDashboard()">
                                <i class="fas fa-sync fa-2x mb-2 d-block"></i>
                                Refresh
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Today's Patient Appointments -->
    <div class="row mb-4" id="todaysAppointments">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="fas fa-calendar-day me-2"></i>Today's Appointments
                    </h5>
                    <span class="badge bg-light text-dark fs-6">@Model.TodaysPatientAppointments.Count appointments</span>
                </div>
                <div class="card-body">
                    @if (Model.TodaysPatientAppointments.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>Patient Name</th>
                                        <th>Phone</th>
                                        <th>Time</th>
                                        <th>Age</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var appointment in Model.TodaysPatientAppointments.OrderBy(a => a.StartTime))
                                    {
                                        <tr>
                                            <td>
                                                <i class="fas fa-user-circle text-primary me-2"></i>
                                                @appointment.FullName
                                            </td>
                                            <td>@appointment.Phone</td>
                                            <td>
                                                <span class="badge bg-primary">
                                                    @appointment.StartTime.ToString(@"hh\:mm") - @appointment.EndTime.ToString(@"hh\:mm")
                                                </span>
                                            </td>
                                            <td>@appointment.Age</td>
                                            <td>
                                                <span class="badge @GetStatusBadgeClass(appointment.Status)">
                                                    @appointment.Status
                                                </span>
                                            </td>
                                            <td>
                                                <div class="btn-group btn-group-sm">
                                                    <button onclick="showEdit('@appointment.Id')" class="btn btn-primary">
                                                        <i class="fas fa-edit"></i>
                                                    </button>
                                                    <button onclick="showDelete('@appointment.Id')" class="btn btn-danger">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="fas fa-calendar-times fa-3x text-muted mb-3"></i>
                            <h5 class="text-muted">No appointments for today</h5>
                            <p class="text-muted">All appointments are completed or no appointments scheduled.</p>
                            <button onclick="showCreate()" class="btn btn-success">
                                <i class="fas fa-plus me-2"></i>Add New Appointment
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Patients & All Appointments -->
    <div class="row">
        <!-- Recent Patients -->
        <div class="col-md-6" id="recentPatients">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-users me-2"></i>Recent Patients
                    </h5>
                </div>
                <div class="card-body">
                    @if (Model.RecentPatients.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var patient in Model.RecentPatients.Take(5))
                            {
                                <div class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="mb-1">
                                            <i class="fas fa-user-circle text-primary me-2"></i>@patient.FullName
                                        </h6>
                                        <small class="text-muted">
                                            <i class="fas fa-phone me-1"></i>@patient.Phone
                                            <span class="ms-3">
                                                <i class="fas fa-birthday-cake me-1"></i>Age: @patient.Age
                                            </span>
                                        </small>
                                    </div>
                                    <span class="badge bg-primary">Patient</span>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="fas fa-users fa-3x text-muted mb-3"></i>
                            <p class="text-muted">No patients data available</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- All Appointments Summary -->
        <div class="col-md-6" id="allAppointments">
            <div class="card shadow">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-calendar-alt me-2"></i>All Appointments Summary
                    </h5>
                </div>
                <div class="card-body">
                    @if (Model.AllPatientAppointments.Any())
                    {
                        <div class="row text-center">
                            <div class="col-4">
                                <h3 class="text-primary">@Model.AllPatientAppointments.Count</h3>
                                <small class="text-muted">Total</small>
                            </div>
                            <div class="col-4">
                                <h3 class="text-success">@Model.AllPatientAppointments.Count(a => a.Status == AppointmentStatus.Completed)</h3>
                                <small class="text-muted">Completed</small>
                            </div>
                            <div class="col-4">
                                <h3 class="text-warning">@Model.AllPatientAppointments.Count(a => a.Status == AppointmentStatus.Scheduled)</h3>
                                <small class="text-muted">Scheduled</small>
                            </div>
                        </div>
                        <div class="mt-3">
                            <a asp-controller="PatientAppointment" asp-action="Index" class="btn btn-info w-100">
                                <i class="fas fa-external-link-alt me-2"></i>View Full Appointments List
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="fas fa-calendar-times fa-3x text-muted mb-3"></i>
                            <p class="text-muted">No appointments data available</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="crudModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="crudModalLabel">Appointment</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="crudModalBody"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let crudModal;

        $(document).ready(function () {
            crudModal = new bootstrap.Modal(document.getElementById('crudModal'));
        });

        function showCreate() {
            $.get('@Url.Action("Create", "PatientAppointment")')
                .done(function (data) {
                    $('#crudModalBody').html(data);
                    $('#crudModalLabel').text('Add Patient Appointment');
                    $('#crudModal').modal('show');
                    $.validator.unobtrusive.parse('#createForm');
                });
        }

        function showEdit(id) {
            $.get('@Url.Action("Edit", "PatientAppointment")/' + id)
                .done(function (data) {
                    $('#crudModalBody').html(data);
                    $('#crudModalLabel').text('Edit Appointment');
                    $('#crudModal').modal('show');
                    $.validator.unobtrusive.parse('#editForm');
                });
        }

        function showDelete(id) {
            $.get('@Url.Action("Delete", "PatientAppointment")/' + id)
                .done(function (data) {
                    $('#crudModalBody').html(data);
                    $('#crudModalLabel').text('Delete Appointment');
                    $('#crudModal').modal('show');
                });
        }

        function refreshDashboard() {
            location.reload();
        }
    </script>
}

@functions {
    string GetStatusBadgeClass(DentalCareManagmentSystem.Domain.Enums.AppointmentStatus status)
    {
        return status switch
        {
            DentalCareManagmentSystem.Domain.Enums.AppointmentStatus.Scheduled => "bg-primary",
            DentalCareManagmentSystem.Domain.Enums.AppointmentStatus.Completed => "bg-success",
            DentalCareManagmentSystem.Domain.Enums.AppointmentStatus.Cancelled => "bg-danger",
            DentalCareManagmentSystem.Domain.Enums.AppointmentStatus.NoShow => "bg-warning",
            DentalCareManagmentSystem.Domain.Enums.AppointmentStatus.Notified => "bg-info",
            _ => "bg-secondary"
        };
    }
}