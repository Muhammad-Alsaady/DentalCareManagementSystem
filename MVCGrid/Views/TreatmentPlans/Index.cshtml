@model List<DentalCareManagmentSystem.Application.DTOs.TreatmentPlanDto>
@{
    ViewData["Title"] = "Treatment Plans";
}

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col-md-12">
            <h2>Treatment Plans</h2>
            <hr />
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-body">
                    @if (Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover table-striped treatment-plans-table">
                                <thead>
                                    <tr>
                                        <th>Patient Name</th>
                                        <th>Created Date</th>
                                        <th>Created By</th>
                                        <th>Total Cost</th>
                                        <th>Items Count</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var plan in Model.OrderByDescending(p => p.CreatedAt))
                                    {
                                        <tr class="treatment-plan-row @(plan.IsCompleted ? "completed-row" : "active-row")">
                                            <td>
                                                <a asp-controller="Patients" asp-action="Details" asp-route-id="@plan.PatientId" class="patient-link">
                                                    @plan.PatientName
                                                </a>
                                            </td>
                                            <td>@plan.CreatedAt.ToString("dd/MM/yyyy")</td>
                                            <td>@plan.CreatedBy</td>
                                            <td><strong>@plan.TotalCost.ToString("C")</strong></td>
                                            <td>
                                                <span class="badge bg-info">@plan.Items.Count items</span>
                                            </td>
                                            <td>
                                                @if (plan.IsCompleted)
                                                {
                                                    <span class="badge bg-success">Completed</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning">In Progress</span>
                                                }
                                            </td>
                                            <td>
                                                <a asp-action="Details" asp-route-id="@plan.Id" class="btn btn-sm btn-info">
                                                    <i class="fas fa-eye"></i> View
                                                </a>

                                                @if (!plan.IsCompleted)
                                                {
                                                    <button class="btn btn-sm btn-primary add-item-btn"
                                                            data-plan-id="@plan.Id">
                                                        <i class="fas fa-plus"></i> Add Item
                                                    </button>

                                                    <button class="btn btn-sm btn-success complete-plan-btn"
                                                            data-plan-id="@plan.Id">
                                                        <i class="fas fa-check"></i> Complete
                                                    </button>

                                                    <!-- زر تطبيق الخصم -->
                                                    <button class="btn btn-sm btn-warning apply-discount-btn"
                                                            data-plan-id="@plan.Id">
                                                        <i class="fas fa-percent"></i> Apply Discount
                                                    </button>
                                                }

                                                @if (User.IsInRole("SystemAdmin"))
                                                {
                                                    <button class="btn btn-sm btn-danger delete-plan-btn"
                                                            data-plan-id="@plan.Id">
                                                        <i class="fas fa-trash"></i> Delete
                                                    </button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td colspan="3"><strong>Total:</strong></td>
                                        <td><strong>@Model.Sum(p => p.TotalCost).ToString("C")</strong></td>
                                        <td colspan="3"></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle"></i>
                            No treatment plans found.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        /* Treatment Plans Table Styling */
        .treatment-plans-table {
            background-color: white;
            border-collapse: separate;
            border-spacing: 0;
        }

        .treatment-plans-table thead th {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            font-weight: 600;
            padding: 12px 8px;
            border: none;
            position: sticky;
            top: 0;
            z-index: 10;
        }

        .treatment-plans-table tbody tr {
            transition: all 0.2s ease;
            background-color: white;
            cursor: pointer;
        }

        /* Active row styling */
        .treatment-plans-table tbody tr.active-row {
            background-color: #ffffff;
            opacity: 1;
        }

        /* Completed row styling */
        .treatment-plans-table tbody tr.completed-row {
            background-color: #f8f9fa;
        }

        /* Striped rows */
        .treatment-plans-table tbody tr:nth-child(even) {
            background-color: #f8f9fa;
        }

        .treatment-plans-table tbody tr.active-row:nth-child(even) {
            background-color: #f0f7ff;
        }

        /* Hover effect - make it very clear it's interactive */
        .treatment-plans-table tbody tr:hover {
            background-color: #e3f2fd !important;
            transform: scale(1.01);
            box-shadow: 0 2px 8px rgba(0,0,0,0.15);
            opacity: 1 !important;
        }

        .treatment-plans-table tbody td {
            padding: 12px 8px;
            border-bottom: 1px solid #e9ecef;
            vertical-align: middle;
            color: #212529;
            font-weight: 500;
        }

        /* Patient link styling */
        .patient-link {
            color: #667eea;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.2s ease;
        }

        .patient-link:hover {
            color: #764ba2;
            text-decoration: underline;
        }

        /* Button styling */
        .treatment-plans-table .btn {
            margin: 2px;
            font-weight: 500;
            transition: all 0.2s ease;
        }

        .treatment-plans-table .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.2);
        }

        /* Badge styling */
        .treatment-plans-table .badge {
            font-size: 0.85rem;
            padding: 6px 12px;
            font-weight: 600;
        }

        /* Footer styling */
        .treatment-plans-table tfoot td {
            background-color: #f8f9fa;
            font-weight: 700;
            padding: 12px 8px;
            border-top: 2px solid #667eea;
        }

        /* Card styling */
        .card {
            border-radius: 0.5rem;
            box-shadow: 0 0.125rem 0.25rem rgba(0,0,0,0.075);
            border: none;
        }

        .card-body {
            padding: 1.5rem;
        }

        /* Responsive adjustments */
        @@media (max-width: 768px) {
            .treatment-plans-table tbody td {
                font-size: 0.9rem;
                padding: 8px 4px;
            }

            .treatment-plans-table .btn {
                font-size: 0.75rem;
                padding: 4px 8px;
            }
        }
    </style>
}

@section Scripts {
    <script>
        $(document).on('click', '.add-item-btn', function () {
            var planId = $(this).data('plan-id');
            $.get('@Url.Action("AddItem")', { planId: planId }, function (data) {
                $('#modalContainer').html(data);
                $('#actionModal').modal('show');
            });
        });

        $(document).on('click', '.complete-plan-btn', function () {
            var planId = $(this).data('plan-id');
            if (confirm('Are you sure you want to mark this treatment plan as completed?')) {
                $.post('@Url.Action("Complete")',
                    {
                        id: planId,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    },
                    function (response) {
                        if (response.success) {
                            showAlert('success', response.message);
                            location.reload();
                        } else {
                            showAlert('danger', response.message);
                        }
                    }
                );
            }
        });

        $(document).on('click', '.delete-plan-btn', function () {
            var planId = $(this).data('plan-id');
            if (confirm('Are you sure you want to delete this treatment plan? This action cannot be undone.')) {
                $.post('@Url.Action("Delete")',
                    {
                        id: planId,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    },
                    function (response) {
                        if (response.success) {
                            showAlert('success', response.message);
                            location.reload();
                        } else {
                            showAlert('danger', response.message);
                        }
                    }
                );
            }
        });

        // زر تطبيق الخصم
        $(document).on('click', '.apply-discount-btn', function () {
            var planId = $(this).data('plan-id');
            var percentage = prompt("Enter discount percentage (0-100):");

            if (percentage !== null) {
                percentage = parseFloat(percentage);
                if (isNaN(percentage) || percentage < 0 || percentage > 100) {
                    alert("Invalid percentage value!");
                    return;
                }

                $.post('@Url.Action("ApplyDiscount", "Payments")',
                    {
                        planId: planId,
                        percentage: percentage,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    },
                    function (response) {
                        if (response.success) {
                            alert(response.message);
                            location.reload();
                        } else {
                            alert(response.message);
                        }
                    }
                );
            }
        });
    </script>
}
