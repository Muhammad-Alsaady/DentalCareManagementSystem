@model List<DentalCareManagmentSystem.Application.DTOs.PatientAppointmentDto>

@{
    ViewData["Title"] = "Patient Appointments";
}

<div class="container-fluid">

    <!-- Header -->
    <div class="row mb-3">
        <div class="col-md-12">
            <div class="d-flex justify-content-between align-items-center">
                <h2><i class="fas fa-calendar-alt"></i> Patient Appointments</h2>

                <div>
                    <button class="btn btn-success" onclick="showCreate()">
                        <i class="fas fa-plus"></i> Add Patient Appointment
                    </button>

                    <button class="btn btn-outline-primary" onclick="refreshGrid()">
                        <i class="fas fa-sync"></i> Refresh
                    </button>
                </div>
            </div>
            <hr />
        </div>
    </div>

    <!-- Search -->
    <div class="row mb-3">
        <div class="col-md-12">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="input-group">
                        <input type="text" id="searchInput" class="form-control"
                               placeholder="Search by patient name..."
                               onkeypress="if(event.keyCode==13) performSearch()" />
                        <button class="btn btn-primary" onclick="performSearch()">
                            <i class="fas fa-search"></i> Search
                        </button>
                        <button class="btn btn-secondary" onclick="clearSearch()">
                            <i class="fas fa-times"></i> Clear
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Grid -->
    <div class="row">
        <div class="col-md-12">
            <div class="card shadow-sm">
                <div class="card-body" id="gridContainer">
                    @await Html.PartialAsync("_PatientAppointmentsGrid", Model)
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="crudModal" tabindex="-1" aria-labelledby="crudModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="crudModalLabel">Appointment</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="crudModalBody">
                <!-- Dynamic content will be loaded here -->
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        let crudModal;

        $(document).ready(function () {
            // Initialize Bootstrap modal
            var modalElement = document.getElementById('crudModal');
            crudModal = new bootstrap.Modal(modalElement, {
                keyboard: true,
                backdrop: true,
                focus: true
            });

            // Setup form submission handler
            setupFormHandler();
        });

        function setupFormHandler() {
            $(document).on('submit', '.appointment-form', function (e) {
                e.preventDefault();
                
                var $form = $(this);
                
                // Validate form
                if (!$form.valid()) {
                    return false;
                }

                var formData = $form.serialize();
                var url = $form.attr('action') || '@Url.Action("Create", "PatientAppointment")';
                
                $.ajax({
                    url: url,
                    type: 'POST',
                    data: formData,
                    success: function (response) {
                        if (response.success) {
                            UIHelpers.showAlert(response.message, 'success');
                            crudModal.hide();
                            refreshGrid();
                        } else {
                            UIHelpers.showAlert(response.message || 'An error occurred', 'danger');
                        }
                    },
                    error: function (xhr, status, error) {
                        UIHelpers.showAlert('Error: ' + error, 'danger');
                    }
                });
            });
        }

        function showCreate() {
            $.get('@Url.Action("Create", "PatientAppointment")')
                .done(function (data) {
                    $('#crudModalBody').html(data);
                    $('#crudModalLabel').text('Add Patient Appointment');
                    crudModal.show();
                    
                    // Initialize validation
                    var form = $('#crudModalBody').find('form');
                    $.validator.unobtrusive.parse(form);
                })
                .fail(function (xhr, status, error) {
                    UIHelpers.showAlert('Error loading form: ' + error, 'danger');
                });
        }

        function showEdit(id) {
            $.get('@Url.Action("Edit", "PatientAppointment")/' + id)
                .done(function (data) {
                    $('#crudModalBody').html(data);
                    $('#crudModalLabel').text('Edit Appointment');
                    crudModal.show();
                    
                    // Initialize validation
                    var form = $('#crudModalBody').find('form');
                    $.validator.unobtrusive.parse(form);
                })
                .fail(function (xhr, status, error) {
                    UIHelpers.showAlert('Error loading form: ' + error, 'danger');
                });
        }

        function showDelete(id) {
            $.get('@Url.Action("Delete", "PatientAppointment")/' + id)
                .done(function (data) {
                    $('#crudModalBody').html(data);
                    $('#crudModalLabel').text('Delete Appointment');
                    crudModal.show();
                })
                .fail(function (xhr, status, error) {
                    UIHelpers.showAlert('Error loading form: ' + error, 'danger');
                });
        }

        function refreshGrid() {
            $.get('@Url.Action("GetAppointmentsGrid", "PatientAppointment")')
                .done(function (data) {
                    $('#gridContainer').html(data);
                })
                .fail(function () {
                    UIHelpers.showAlert('Failed to refresh grid', 'danger');
                });
        }

        function performSearch() {
            var searchTerm = $("#searchInput").val();
            $.get('@Url.Action("GetAppointmentsGrid", "PatientAppointment")', { searchString: searchTerm })
                .done(function (data) {
                    $('#gridContainer').html(data);
                })
                .fail(function () {
                    UIHelpers.showAlert('Search failed', 'danger');
                });
        }

        function clearSearch() {
            $("#searchInput").val("");
            refreshGrid();
        }
    </script>
}
