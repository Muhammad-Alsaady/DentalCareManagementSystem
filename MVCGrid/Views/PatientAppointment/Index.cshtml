@model List<DentalCareManagmentSystem.Application.DTOs.PatientAppointmentDto>

@{
    ViewData["Title"] = "Patient Appointments";
}

<div class="container-fluid">

    <!-- Header -->
    <div class="row mb-3">
        <div class="col-md-12">
            <div class="d-flex justify-content-between align-items-center">
                <h2><i class="fas fa-calendar-alt"></i> Patient Appointments</h2>

                <div>
                    <button class="btn btn-success" onclick="showCreate()">
                        <i class="fas fa-plus"></i> Add Patient Appointment
                    </button>


                    <button class="btn btn-outline-primary" onclick="refreshGrid()">
                        <i class="fas fa-sync"></i> Refresh
                    </button>
                </div>
            </div>
            <hr />
        </div>
    </div>

    <!-- Search -->
    <div class="row mb-3">
        <div class="col-md-12">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="input-group">
                        <input type="text" id="searchInput" class="form-control"
                               placeholder="Search by patient name..."
                               onkeypress="if(event.keyCode==13) performSearch()" />
                        <button class="btn btn-primary" onclick="performSearch()">
                            <i class="fas fa-search"></i> Search
                        </button>
                        <button class="btn btn-secondary" onclick="clearSearch()">
                            <i class="fas fa-times"></i> Clear
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Grid -->
    <div class="row">
        <div class="col-md-12">
            <div class="card shadow-sm">
                <div class="card-body" id="gridContainer">
                    @await Html.PartialAsync("_PatientAppointmentsGrid", Model)
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="crudModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="crudModalLabel">Appointment</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body" id="crudModalBody"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let crudModal;

        $(document).ready(function () {
            crudModal = new bootstrap.Modal(document.getElementById('crudModal'));
            UIHelpers.ajaxFormHandler('.appointment-form', function () {
                refreshGrid();
            });
        });
                      function showCreate() {
            console.log('showCreate function called'); 

            $.get('@Url.Action("Create", "PatientAppointment")')
                .done(function (data) {
                    console.log('Form data loaded:', data); 
                    $('#crudModalBody').html(data);
                    $('#crudModalLabel').text('Add Patient Appointment');
                    $('#crudModal').modal('show');

                    // إعادة تهيئة الـ validation
                    $.validator.unobtrusive.parse('#createForm');
                })
                .fail(function (xhr, status, error) {
                    console.error('Error loading form:', error);
                    alert('Error loading form: ' + error);
                });
        }

        function showEdit(id) {
            UIHelpers.loadModal('@Url.Action("Edit", "PatientAppointment")/' + id, 'Edit Appointment');
        }

        function showDelete(id) {
            UIHelpers.loadModal('@Url.Action("Delete", "PatientAppointment")/' + id, 'Delete Appointment');
        }

        function refreshGrid() {
            UIHelpers.reloadGridPartial("#gridContainer", '@Url.Action("GetAppointmentsGrid", "PatientAppointment")');
        }

        function performSearch() {
            let term = $("#searchInput").val();
            UIHelpers.reloadGridPartial("#gridContainer", '@Url.Action("GetAppointmentsGrid", "PatientAppointment")', { searchString: term });
        }

        function clearSearch() {
            $("#searchInput").val("");
            refreshGrid();
        }


        function refreshGrid() {
            UIHelpers.reloadGridPartial("#gridContainer", '@Url.Action("GetAppointmentsGrid")');
        }











    </script>
}
