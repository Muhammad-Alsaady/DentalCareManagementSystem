@using Microsoft.AspNetCore.Mvc.Localization
@model List<DentalCareManagmentSystem.Application.DTOs.PatientAppointmentDto>
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = "Patient Appointments";
    var filterDate = ViewBag.FilterDate ?? DateTime.Today;
    ViewData["Title"] = Localizer["Title"];
}

<div class="container-fluid">

    <!-- Header -->
    <div class="row mb-3">
        <div class="col-md-12">
            <div class="d-flex justify-content-between align-items-center">
                <h2><i class="fas fa-calendar-alt"></i> @Localizer["Title"]</h2>

                <div>
                    <button class="btn btn-success" onclick="showCreate()">
                        <i class="fas fa-plus"></i> @Localizer["AddButton"]
                    </button>

                    <button class="btn btn-outline-primary" onclick="refreshGrid()">
                        <i class="fas fa-sync"></i> @Localizer["RefreshButton"]
                    </button>
                </div>
            </div>
            <hr />
        </div>
    </div>

    <!-- Date Filter and Search -->
    <div class="row mb-3">
        <div class="col-md-12">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-md-4">
                            <label for="appointmentDate" class="form-label fw-bold">
                                <i class="fas fa-calendar"></i> Filter by Date:
                            </label>
                            <input type="date"
                                   id="appointmentDate"
                                   class="form-control"
                                   value="@filterDate.ToString("yyyy-MM-dd")"
                                   onchange="filterByDate(this.value)">
                            <small class="text-muted">Leave blank to show all appointments</small>
                        </div>
                        <div class="col-md-1 text-center">
                            <button class="btn btn-secondary" onclick="clearDateFilter()" title="Clear date filter">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                        <div class="col-md-7">
                            <label class="form-label fw-bold">
                                <i class="fas fa-search"></i> Search by Name:
                            </label>
                            <div class="input-group">
                                <input type="text" id="searchInput" class="form-control"
                                       placeholder="Search by patient name..."
                                       onkeypress="if(event.keyCode==13) performSearch()" />
                                <button class="btn btn-primary" onclick="performSearch()">
                                    <i class="fas fa-search"></i> Search
                                </button>
                                <button class="btn btn-secondary" onclick="clearSearch()">
                                    <i class="fas fa-times"></i> Clear
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="input-group">
        <input type="text" id="searchInput" class="form-control"
               placeholder="@Localizer["SearchPlaceholder"]"
               onkeypress="if(event.keyCode==13) performSearch()" />
        <button class="btn btn-primary" onclick="performSearch()">
            <i class="fas fa-search"></i> @Localizer["SearchButton"]
        </button>
        <button class="btn btn-secondary" onclick="clearSearch()">
            <i class="fas fa-times"></i> @Localizer["ClearButton"]
        </button>
    </div>
</div>
</div>
</div>
</div>

<!-- Grid -->
<div class="row">
    <div class="col-md-12">
        <div class="card shadow-sm">
            <div class="card-body" id="gridContainer">
                @await Html.PartialAsync("_PatientAppointmentsGrid", Model)
            </div>
        </div>
    </div>
</div>
</div>

<!-- Modal -->
<div class="modal fade" id="crudModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="crudModalLabel">@Localizer["Appointment"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body" id="crudModalBody"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let crudModal;
        const texts = {
            addButton: '@Localizer["AddButton"]',
            editButton: '@Localizer["EditButton"]',
            deleteButton: '@Localizer["DeleteButton"]',
            appointmentLabel: '@Localizer["Appointment"]',
            searchPlaceholder: '@Localizer["SearchPlaceholder"]'
        };

        $(document).ready(function () {
            // Listen for modal success event to refresh grid
            $(document).on('modalSuccess', function(event, response) {
                console.log('Appointment saved successfully, refreshing grid...');
                refreshGrid();
            });

            // تعيين placeholder للبحث
            $("#searchInput").attr("placeholder", texts.searchPlaceholder);
        });

        function showCreate() {
            $.get('@Url.Action("Create", "PatientAppointment")')
                .done(function (data) {
                    $('#crudModalBody').html(data);
                    $('#crudModalLabel').text(texts.addButton);
                    $('#crudModal').modal('show');
                    $.validator.unobtrusive.parse('#createForm');
                })
                .fail(function (xhr, status, error) {
                    console.error('Error loading form:', error);
                    alert('Error loading form: ' + error);
                });
        }

        // Show Edit Form
        function showEdit(id) {
            UIHelpers.loadModal('@Url.Action("Edit", "PatientAppointment")/' + id, texts.editButton);
        }
               function showTreatmentPlan(appointmentId) {
            $.get('/Reception/GetTreatmentPlanForm?appointmentId=' + appointmentId)
                .done(function (data) {
                    $('#crudModalBody').html(data);
                    $('#crudModalLabel').text('Create Treatment Plan');
                    $('#crudModal').modal('show');
                })
                .fail(function (xhr, status, error) {
                    alert("Error loading treatment plan.");
                    console.error(error);
                });
        }


        // Show Details
        function showDetails(id) {
            UIHelpers.loadModal('@Url.Action("Details", "PatientAppointment")/' + id, 'Patient Appointment Details');
        }

        // Show Delete Confirmation
        function showDelete(id) {
            UIHelpers.loadModal('@Url.Action("Delete", "PatientAppointment")/' + id, texts.deleteButton);
        }

        // Filter by Date
        function filterByDate(date) {
            var searchTerm = $("#searchInput").val();
            var params = {};

            if (date) {
                params.filterDate = date;
            }
            if (searchTerm) {
                params.searchString = searchTerm;
            }

            UIHelpers.reloadGridPartial(
                '#gridContainer',
                '@Url.Action("GetAppointmentsGrid", "PatientAppointment")',
                params
            );
        }

        // Clear Date Filter
        function clearDateFilter() {
            $('#appointmentDate').val('');
            filterByDate('');
        }

        // Refresh Grid
        function refreshGrid() {
            var date = $('#appointmentDate').val();
            var searchTerm = $("#searchInput").val();
            var params = {};

            if (date) {
                params.filterDate = date;
            }
            if (searchTerm) {
                params.searchString = searchTerm;
            }

            UIHelpers.reloadGridPartial(
                '#gridContainer',
                '@Url.Action("GetAppointmentsGrid", "PatientAppointment")',
                params
            );
        }

        // Perform Search
        function performSearch() {
            var searchTerm = $("#searchInput").val();
            var date = $('#appointmentDate').val();
            var params = {};

            if (searchTerm) {
                params.searchString = searchTerm;
            }
            if (date) {
                params.filterDate = date;
            }

            UIHelpers.reloadGridPartial(
                '#gridContainer',
                '@Url.Action("GetAppointmentsGrid", "PatientAppointment")',
                params
            );
        }

        // Clear Search
        function clearSearch() {
            $("#searchInput").val("");
            refreshGrid();
        }

        // Send Patient to Doctor
        function sendToDoctor(id) {
            if (confirm('Are you sure you want to send this patient to the doctor?')) {
                $.ajax({
                    url: '@Url.Action("SendToDoctor", "PatientAppointment")',
                    type: 'POST',
                    data: {
                        id: id,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function (response) {
                        if (response.success) {
                            UIHelpers.showNotification(response.message, 'success');
                            refreshGrid();
                        } else {
                            UIHelpers.showNotification(response.message, 'error');
                        }
                    },
                    error: function () {
                        UIHelpers.showNotification('An error occurred while sending the patient to the doctor.', 'error');
                    }
                });
            }
        }
                function showTreatmentPlan(appointmentId) {
            $.get('@Url.Action("GetTreatmentPlanForm", "Reception")?appointmentId=' + appointmentId)
                .done(function (data) {
                    $('#crudModalBody').html(data);
                    $('#crudModalLabel').text('Treatment Plan');
                    $('#crudModal').modal('show');
                })
                .fail(function (xhr, status, error) {
                    console.error('Error loading treatment plan form:', error);
                    alert('Error loading form: ' + error);
                });
        }


        // Show Payment Modal
        function showPaymentModal(appointmentId) {
            $.ajax({
                url: '@Url.Action("GetPaymentModal", "Reception")',
                type: 'GET',
                data: { appointmentId: appointmentId },
                success: function (data) {
                    $('#crudModalBody').html(data);
                    $('#crudModalLabel').text('Process Payment');
                    $('#crudModal').modal('show');
                },
                error: function () {
                    UIHelpers.showNotification('Error loading payment form.', 'error');
                }
            });
        }
    </script>
}
