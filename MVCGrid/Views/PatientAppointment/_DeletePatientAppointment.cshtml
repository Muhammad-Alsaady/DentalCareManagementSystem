@model DentalCareManagmentSystem.Application.DTOs.PatientAppointmentDto

<div class="alert alert-warning">
    Are you sure you want to delete this appointment for:
    <br />
    <b>@Model.FullName</b> on <b>@Model.Date.ToShortDateString()</b>?
</div>

<form id="deleteForm">
    @Html.AntiForgeryToken()

    <div class="modal-footer">
        <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-danger">Delete</button>
    </div>
</form>

<script>
    $("#deleteForm").submit(function (e) {
        e.preventDefault();

        $.post('@Url.Action("DeleteConfirmed", new { id = Model.Id })', function (res) {
            if (res.success) {
                crudModal.hide();
                refreshGrid();
            }
        });
    });
</script>
