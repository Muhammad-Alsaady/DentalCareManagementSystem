@model DentalCareManagmentSystem.Application.DTOs.PatientAppointmentDto

<div class="alert alert-warning">
    <i class="fas fa-exclamation-triangle"></i>
    Are you sure you want to delete this appointment?
    <br /><br />
    <strong>Patient:</strong> @Model.FullName<br />
    <strong>Date:</strong> @Model.Date.ToShortDateString()<br />
    <strong>Time:</strong> @Model.StartTime.ToString(@"hh\:mm") - @Model.EndTime.ToString(@"hh\:mm")
</div>

<form class="appointment-form" id="deleteForm" action="@Url.Action("DeleteConfirmed", "PatientAppointment", new { id = Model.Id })" method="post">
    @Html.AntiForgeryToken()

    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-danger">
            <i class="fas fa-trash"></i> Delete
        </button>
    </div>
</form>
