@model DentalCareManagmentSystem.Application.DTOs.PatientAppointmentDto

<div class="modal-header bg-danger text-white">
    <h5 class="modal-title">
        <i class="fas fa-exclamation-triangle"></i> Delete Appointment
    </h5>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<div class="modal-body">
    <div class="alert alert-warning mb-4">
        <i class="fas fa-exclamation-triangle"></i>
        <strong>Warning:</strong> Are you sure you want to delete this appointment? This action cannot be undone.
    </div>

    <div class="card">
        <div class="card-body">
            <h6 class="card-subtitle mb-3 text-muted">Appointment Details</h6>
            <div class="row">
                <div class="col-md-6">
                    <p><strong>Patient:</strong> @Model.FullName</p>
                    <p><strong>Phone:</strong> @Model.Phone</p>
                </div>
                <div class="col-md-6">
                    <p><strong>Date:</strong> @Model.Date.ToShortDateString()</p>
                    <p><strong>Time:</strong> @Model.StartTime.ToString(@"hh\:mm") - @Model.EndTime.ToString(@"hh\:mm")</p>
                </div>
            </div>
            @if (!string.IsNullOrEmpty(Model.Notes))
            {
                <hr />
                <p><strong>Notes:</strong> @Model.Notes</p>
            }
        </div>
    </div>

    <form class="appointment-form mt-3" id="deleteForm" action="@Url.Action("DeleteConfirmed", "PatientAppointment", new { id = Model.Id })" method="post">
        @Html.AntiForgeryToken()

        <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                <i class="fas fa-times"></i> Cancel
            </button>
            <button type="submit" class="btn btn-danger">
                <i class="fas fa-trash"></i> Delete Appointment
            </button>
        </div>
    </form>
</div>
