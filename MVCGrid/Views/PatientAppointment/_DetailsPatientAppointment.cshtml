@model DentalCareManagmentSystem.Application.DTOs.PatientAppointmentDto

<!-- Details content only - Modal structure provided by global modal -->
<div class="container-fluid">
    <!-- Patient Information -->
    <div class="row mb-3">
        <div class="col-md-12">
            <h6 class="text-primary border-bottom pb-2">
                <i class="fas fa-user"></i> Patient Information
            </h6>
        </div>
    </div>
    
    <div class="row mb-3">
        <div class="col-md-6">
            <div class="mb-2">
                <strong>Full Name:</strong>
                <p class="text-muted mb-0">@Model.FullName</p>
            </div>
        </div>
        <div class="col-md-3">
            <div class="mb-2">
                <strong>Age:</strong>
                <p class="text-muted mb-0">@Model.Age years</p>
            </div>
        </div>
        <div class="col-md-3">
            <div class="mb-2">
                <strong>Gender:</strong>
                <p class="text-muted mb-0">@Model.Gender</p>
            </div>
        </div>
    </div>
    
    <div class="row mb-3">
        <div class="col-md-6">
            <div class="mb-2">
                <strong>Phone:</strong>
                <p class="text-muted mb-0">
                    <i class="fas fa-phone"></i> @Model.Phone
                </p>
            </div>
        </div>
        <div class="col-md-6">
            <div class="mb-2">
                <strong>Status:</strong>
                <p class="mb-0">
                    @{
                        string badgeClass = Model.Status switch
                        {
                            DentalCareManagmentSystem.Domain.Enums.AppointmentStatus.Scheduled => "bg-primary",
                            DentalCareManagmentSystem.Domain.Enums.AppointmentStatus.Completed => "bg-success",
                            DentalCareManagmentSystem.Domain.Enums.AppointmentStatus.Cancelled => "bg-danger",
                            DentalCareManagmentSystem.Domain.Enums.AppointmentStatus.NoShow => "bg-warning",
                            DentalCareManagmentSystem.Domain.Enums.AppointmentStatus.Notified => "bg-info",
                            _ => "bg-secondary"
                        };
                    }
                    <span class="badge @badgeClass">@Model.Status</span>
                </p>
            </div>
        </div>
    </div>

    <!-- Appointment Information -->
    <div class="row mb-3 mt-4">
        <div class="col-md-12">
            <h6 class="text-primary border-bottom pb-2">
                <i class="fas fa-calendar-alt"></i> Appointment Information
            </h6>
        </div>
    </div>
    
    <div class="row mb-3">
        <div class="col-md-4">
            <div class="mb-2">
                <strong>Date:</strong>
                <p class="text-muted mb-0">
                    <i class="fas fa-calendar"></i> @Model.Date.ToString("MMMM dd, yyyy")
                </p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="mb-2">
                <strong>Start Time:</strong>
                <p class="text-muted mb-0">
                    <i class="fas fa-clock"></i> @Model.StartTime.ToString(@"hh\:mm")
                </p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="mb-2">
                <strong>End Time:</strong>
                <p class="text-muted mb-0">
                    <i class="fas fa-clock"></i> @Model.EndTime.ToString(@"hh\:mm")
                </p>
            </div>
        </div>
    </div>
    
    <div class="row mb-3">
        <div class="col-md-12">
            <div class="mb-2">
                <strong>Created:</strong>
                <p class="text-muted mb-0">
                    <i class="fas fa-calendar-plus"></i> @Model.CreatedAt.ToString("MMMM dd, yyyy hh:mm tt")
                </p>
            </div>
        </div>
    </div>

    <!-- Payment Information -->
    <div class="row mb-3 mt-4">
        <div class="col-md-12">
            <h6 class="text-primary border-bottom pb-2">
                <i class="fas fa-dollar-sign"></i> Payment Information
            </h6>
        </div>
    </div>
    
    <div class="row mb-3">
        <div class="col-md-4">
            <div class="card border-primary">
                <div class="card-body text-center">
                    <small class="text-muted">Total Cost</small>
                    <h4 class="text-primary mb-0">$@Model.TotalCost.ToString("N2")</h4>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-success">
                <div class="card-body text-center">
                    <small class="text-muted">Paid Amount</small>
                    <h4 class="text-success mb-0">$@Model.PaidAmount.ToString("N2")</h4>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card @(Model.Remainder > 0 ? "border-danger" : "border-success")">
                <div class="card-body text-center">
                    <small class="text-muted">Remainder</small>
                    <h4 class="@(Model.Remainder > 0 ? "text-danger" : "text-success") mb-0">
                        $@Model.Remainder.ToString("N2")
                    </h4>
                </div>
            </div>
        </div>
    </div>
    
    @if (Model.Remainder > 0)
    {
        <div class="row mb-3">
            <div class="col-md-12">
                <div class="alert alert-warning" role="alert">
                    <i class="fas fa-exclamation-triangle"></i>
                    <strong>Outstanding Balance:</strong> This patient has an outstanding balance of $@Model.Remainder.ToString("N2")
                </div>
            </div>
        </div>
    }
    else if (Model.Remainder == 0 && Model.TotalCost > 0)
    {
        <div class="row mb-3">
            <div class="col-md-12">
                <div class="alert alert-success" role="alert">
                    <i class="fas fa-check-circle"></i>
                    <strong>Paid in Full:</strong> This appointment has been fully paid.
                </div>
            </div>
        </div>
    }

    <!-- Notes -->
    @if (!string.IsNullOrEmpty(Model.Notes))
    {
        <div class="row mb-3 mt-4">
            <div class="col-md-12">
                <h6 class="text-primary border-bottom pb-2">
                    <i class="fas fa-sticky-note"></i> Notes
                </h6>
            </div>
        </div>
        
        <div class="row mb-3">
            <div class="col-md-12">
                <div class="card bg-light">
                    <div class="card-body">
                        <p class="mb-0">@Model.Notes</p>
                    </div>
                </div>
            </div>
        </div>
    }
    
    <!-- Footer Buttons -->
    <div class="d-flex justify-content-end gap-2 mt-3 pt-3 border-top">
        <button type="button" class="btn btn-primary" onclick="editAppointment('@Model.Id')">
            <i class="fas fa-edit"></i> Edit Appointment
        </button>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
            <i class="fas fa-times"></i> Close
        </button>
    </div>
</div>

<script>
    // Function to show edit modal (will close current details modal and open edit)
    function editAppointment(id) {
        // Close the details modal
        ModalLoader.close();
        
        // Wait a bit for modal to close, then open edit
        setTimeout(function() {
            UIHelpers.loadModal('@Url.Action("Edit", "PatientAppointment")/' + id, 'Edit Appointment');
        }, 300);
    }
</script>
