@using DentalCareManagmentSystem.Application.DTOs
@model CreatePatientAppointmentDto

<form class="appointment-form" id="createForm">
    @Html.AntiForgeryToken()
    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="FullName" class="form-label">Patient Name</label>
            <input asp-for="FullName" class="form-control" required />
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="Phone" class="form-label">Phone</label>
            <input asp-for="Phone" class="form-control" required />
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="Age" class="form-label">Age</label>
            <input asp-for="Age" class="form-control" required />
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="Gender" class="form-label">Gender</label>
            <select asp-for="Gender" class="form-control">
                <option value="">Select...</option>
                <option>Male</option>
                <option>Female</option>
            </select>
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="Date" class="form-label">Date</label>
            <input asp-for="Date" type="date" class="form-control" required />
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="StartTime" class="form-label">Start Time</label>
            <input asp-for="StartTime" type="time" class="form-control" required />
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="EndTime" class="form-label">End Time</label>
            <input asp-for="EndTime" type="time" class="form-control" required />
        </div>
        <div class="col-md-12 mb-3">
            <label asp-for="Notes" class="form-label">Notes</label>
            <textarea asp-for="Notes" class="form-control"></textarea>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-success">Create</button>
    </div>
</form>

<script>
    $.validator.unobtrusive.parse('#createForm');
</script>
