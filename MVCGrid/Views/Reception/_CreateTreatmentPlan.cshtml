@model DentalManagementSystem.Models.TreatmentPlanViewModel

<div class="modal-header">
    <h5 class="modal-title">Create Treatment Plan</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>

<div class="modal-body">
    <form class="treatment-form" id="treatmentForm" method="post" action="@Url.Action("CreateTreatmentPlan", "Reception")">
        @Html.AntiForgeryToken()
        <input type="hidden" name="AppointmentId" value="@Model.AppointmentId" />
        <input type="hidden" name="PatientId" value="@Model.PatientId" />

        <div id="treatmentItemsContainer">
            @if (Model.TreatmentItems.Any())
            {
                @for (int i = 0; i < Model.TreatmentItems.Count; i++)
                {
                    <div class="treatment-item row mb-2 border p-2">
                        <div class="col-md-5">
                            <label class="form-label small">Service Name</label>
                            <input name="TreatmentItems[@i].Name"
                                   value="@Model.TreatmentItems[i].Name"
                                   class="form-control form-control-sm service-name"
                                   placeholder="Service Name" required />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small">Price</label>
                            <input name="TreatmentItems[@i].Price"
                                   value="@Model.TreatmentItems[i].Price"
                                   class="form-control form-control-sm price-input"
                                   type="number" step="0.01" min="0" required />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small">Quantity</label>
                            <input name="TreatmentItems[@i].Quantity"
                                   value="@Model.TreatmentItems[i].Quantity"
                                   class="form-control form-control-sm quantity-input"
                                   type="number" min="1" value="1" required />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small">Line Total</label>
                            <input type="text" class="form-control form-control-sm line-total" readonly
                                   value="@(Model.TreatmentItems[i].LineTotal.ToString("F2"))" />
                        </div>
                        <div class="col-md-1 d-flex align-items-end">
                            <button type="button" class="btn btn-danger btn-sm remove-item"
                                    style="@(i == 0 ? "display:none" : "")">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    </div>
                }
            }
            else
            {
                <!-- Empty first item -->
                <div class="treatment-item row mb-2 border p-2">
                    <div class="col-md-5">
                        <label class="form-label small">Service Name</label>
                        <input name="TreatmentItems[0].Name"
                               class="form-control form-control-sm service-name"
                               placeholder="Service Name" required />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small">Price</label>
                        <input name="TreatmentItems[0].Price"
                               class="form-control form-control-sm price-input"
                               type="number" step="0.01" min="0" required />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small">Quantity</label>
                        <input name="TreatmentItems[0].Quantity"
                               class="form-control form-control-sm quantity-input"
                               type="number" min="1" value="1" required />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small">Line Total</label>
                        <input type="text" class="form-control form-control-sm line-total" readonly value="0.00" />
                    </div>
                    <div class="col-md-1 d-flex align-items-end">
                        <button type="button" class="btn btn-danger btn-sm remove-item" style="display:none">
                            <i class="fas fa-trash"></i>
                        </button>
                    </div>
                </div>
            }
        </div>

        <button type="button" id="addItem" class="btn btn-primary btn-sm mt-2">
            <i class="fas fa-plus"></i> Add Service
        </button>
        <!-- Payment Information Section -->
        <div class="row mt-4">
            <div class="col-md-12">
                <hr />
                <h6><i class="fas fa-dollar-sign"></i> Payment Information</h6>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label class="form-label">Total Cost</label>
                <div class="input-group">
                    <span class="input-group-text">$</span>
                    <input type="text" id="paymentTotalCost" class="form-control" readonly value="0.00" />
                </div>
            </div>

            <div class="col-md-4 mb-3">
                <label class="form-label">Paid Amount</label>
                <div class="input-group">
                    <span class="input-group-text">$</span>
                    <input type="number" step="0.01" min="0" id="paidAmount" class="form-control" value="0" />
                </div>
            </div>

            <div class="col-md-4 mb-3">
                <label class="form-label">Remainder</label>
                <div class="input-group">
                    <span class="input-group-text">$</span>
                    <input type="text" id="remainder" class="form-control" readonly value="0.00" style="font-weight: bold;" />
                </div>
            </div>
        </div>
        <div class="row mt-3">
            <div class="col-md-4 mb-3">
                <label class="form-label">Discount (%)</label>
                <input type="number" step="0.01" min="0" max="100"
                       id="discountPercentage"
                       name="DiscountPercentage"
                       class="form-control" value="0" />
            </div>
        </div>


        <!-- Cost Summary -->
        <div class="row mt-3">
            <div class="col-md-12">
                <div class="card bg-light">
                    <div class="card-body py-2">
                        <div class="d-flex justify-content-between align-items-center">
                            <strong>Total Cost</strong>
                            <span id="totalCost" class="h6 text-success mb-0">$0.00</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-success">Save</button>
        </div>
    </form>
</div>

<script>
    $(document).ready(function() {
        calculateGrandTotal();

        $(document).on('change', '.price-input, .quantity-input', function() {
            calculateLineTotal($(this).closest('.treatment-item'));
            calculateGrandTotal();
        });

        $('#addItem').click(function() {
            addNewTreatmentItem();
        });

        $(document).on('click', '.remove-item', function() {
            $(this).closest('.treatment-item').remove();
            calculateGrandTotal();
            reindexItems();
        });

        $('#treatmentForm').submit(function(e) {
            if ($('.treatment-item').length === 0) {
                e.preventDefault();
                alert('Please add at least one service.');
                return false;
            }
        });
    });

    function calculateLineTotal(item) {
        const price = parseFloat(item.find('.price-input').val()) || 0;
        const quantity = parseInt(item.find('.quantity-input').val()) || 0;
        const lineTotal = price * quantity;
        item.find('.line-total').val(lineTotal.toFixed(2));
    }

    function calculateGrandTotal() {
        let total = 0;
        $('.treatment-item').each(function() {
            const lineTotal = parseFloat($(this).find('.line-total').val()) || 0;
            total += lineTotal;
        });
        $('#totalCost').text('$' + total.toFixed(2));
    }
        function updatePaymentInfo() {
        const totalCost = parseFloat($('#paymentTotalCost').val()) || 0;
        const discountPercent = parseFloat($('#discountPercentage').val()) || 0;
        const amountPaid = parseFloat($('#paidAmount').val()) || 0;

        const discountAmount = totalCost * (discountPercent / 100);
        const remainder = totalCost - discountAmount - amountPaid;

        $('#discountAmount').val(discountAmount.toFixed(2));
        $('#remainder').val(remainder.toFixed(2));
    }

    $(document).ready(function() {
        $('#discountPercentage, #paidAmount').on('input', updatePaymentInfo);
        updatePaymentInfo(); // الحساب عند تحميل الصفحة
    });


    function addNewTreatmentItem() {
        const index = $('.treatment-item').length;
        const newItem = `
            <div class="treatment-item row mb-2 border p-2">
                <div class="col-md-5">
                    <input name="TreatmentItems[${index}].Name" class="form-control form-control-sm service-name" placeholder="Service Name" required />
                </div>
                <div class="col-md-2">
                    <input name="TreatmentItems[${index}].Price" class="form-control form-control-sm price-input" type="number" step="0.01" min="0" required />
                </div>
                <div class="col-md-2">
                    <input name="TreatmentItems[${index}].Quantity" class="form-control form-control-sm quantity-input" type="number" min="1" value="1" required />
                </div>
                <div class="col-md-2">
                    <input type="text" class="form-control form-control-sm line-total" readonly value="0.00" />
                </div>
                <div class="col-md-1 d-flex align-items-end">
                    <button type="button" class="btn btn-danger btn-sm remove-item">
                        <i class="fas fa-trash"></i>
                    </button>
                </div>
            </div>
        `;
        $('#treatmentItemsContainer').append(newItem);
    }
        function updatePaymentInfo() {
        const totalCost = parseFloat($('#totalCost').text().replace('$','')) || 0;
        const paidAmount = parseFloat($('#paidAmount').val()) || 0;
        const remainder = totalCost - paidAmount;

        $('#paymentTotalCost').val(totalCost.toFixed(2));
        $('#remainder').val(remainder.toFixed(2));

        if (remainder > 0) {
            $('#remainder').css('color', '#dc3545'); // Red for outstanding balance
        } else if (remainder < 0) {
            $('#remainder').css('color', '#ffc107'); // Yellow for overpayment
        } else {
            $('#remainder').css('color', '#28a745'); // Green for fully paid
        }
    }

    $(document).ready(function() {
        // Call on page load
        updatePaymentInfo();

        // Update when total cost changes
        $(document).on('change', '.price-input, .quantity-input', function() {
            calculateLineTotal($(this).closest('.treatment-item'));
            calculateGrandTotal();
            updatePaymentInfo();
        });

        // Update when paid amount changes
        $('#paidAmount').on('input', function() {
            updatePaymentInfo();
        });
    });

    function reindexItems() {
        $('.treatment-item').each(function(index) {
            $(this).find('input[name*="Name"]').attr('name', `TreatmentItems[${index}].Name`);
            $(this).find('input[name*="Price"]').attr('name', `TreatmentItems[${index}].Price`);
            $(this).find('input[name*="Quantity"]').attr('name', `TreatmentItems[${index}].Quantity`);
        });
    }
</script>
