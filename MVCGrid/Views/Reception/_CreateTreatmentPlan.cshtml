@using DentalManagementSystem.Models
@model TreatmentPlanViewModel
@* 
<input type="hidden" id="appointmentId" value="@Model.AppointmentId" /> *@
<form id="treatmentPlanForm" method="post" action="@Url.Action("CreateTreatmentPlan", "Reception")">
    @Html.AntiForgeryToken()
    <input type="hidden" name="AppointmentId" value="@Model.AppointmentId" />
    <div class="modal-header bg-primary text-white">
    <h5 class="modal-title">
        <i class="fas fa-stethoscope"></i>
        Create Treatment Plan - @Model.PatientName
    </h5>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
</div>

<div class="modal-body">

    <!-- Patient Info -->
    <div class="card mb-3">
        <div class="card-body">
            <strong>@Model.PatientName</strong><br />
            <small>@Model.PhoneNumber</small>
        </div>
    </div>

    <!-- Services -->
    <div class="card mb-3">
        <div class="card-header">Select Services</div>
        <div class="card-body">

            <div class="row mb-3">
                <div class="col-md-8">
                    <select id="serviceDropdown" class="form-control">
                        <option value="">-- Select Service --</option>
                        @foreach (var s in Model.AvailableServices)
                        {
                            <option value="@s.Id"
                                    data-name="@s.Name"
                                    data-price="@s.DefaultPrice">
                                @s.Name - $@s.DefaultPrice
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <input type="number" id="serviceQuantity" value="1" min="1" class="form-control" />
                </div>

                <div class="col-md-2">
                    <button type="button" class="btn btn-primary w-100" onclick="addService()">
                        Add
                    </button>
                </div>
            </div>

            <table class="table table-bordered" id="servicesTable" style="display:none">
                <thead>
                    <tr>
                        <th>Service</th>
                        <th>Price</th>
                        <th>Qty</th>
                        <th>Total</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="servicesBody"></tbody>
            </table>

            <div id="noServices" class="alert alert-info">
                No services added
            </div>
        </div>
    </div>

    <!-- Payment -->
    <div class="card">
        <div class="card-header">Payment</div>
        <div class="card-body">

            <div class="row">
                <div class="col-md-6">
                    <label>Discount %</label>
                    <input type="number" id="discount" value="0" min="0" max="100"
                           class="form-control" oninput="calculate()" />

                    <label class="mt-2">Paid</label>
                    <input type="number" id="paid" value="0" min="0"
                           class="form-control" oninput="calculate()" />
                </div>

                <div class="col-md-6">
                    <table class="table">
                        <tr>
                            <td>Total</td>
                            <td class="text-end" id="total">$0.00</td>
                        </tr>
                        <tr>
                            <td>Discount</td>
                            <td class="text-end" id="discountValue">$0.00</td>
                        </tr>
                        <tr>
                            <td>Net</td>
                            <td class="text-end" id="net">$0.00</td>
                        </tr>
                        <tr class="border-top">
                            <td>Remaining</td>
                            <td class="text-end fw-bold" id="remaining">$0.00</td>
                        </tr>
                    </table>
                </div>
            </div>

        </div>
    </div>

</div>

    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-success" onclick="saveTreatmentPlan()">
            <i class="fas fa-save"></i> Save Treatment Plan
        </button>
    </div>
</form>






