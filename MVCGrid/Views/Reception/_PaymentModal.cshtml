@model DentalManagementSystem.Models.PaymentViewModel
@{
    var treatmentItems = ViewBag.TreatmentItems as List<DentalCareManagmentSystem.Domain.Entities.TreatmentItem> ?? new List<DentalCareManagmentSystem.Domain.Entities.TreatmentItem>();
    var paymentHistory = ViewBag.PaymentHistory as List<DentalCareManagmentSystem.Domain.Entities.PaymentTransaction> ?? new List<DentalCareManagmentSystem.Domain.Entities.PaymentTransaction>();
}

<div class="modal-header bg-primary text-white">
    <h5 class="modal-title">
        <i class="fas fa-dollar-sign"></i> Process Payment - @Model.PatientName
    </h5>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
</div>

<div class="modal-body">
    <!-- Treatment Items Summary -->
    <div class="card mb-3">
        <div class="card-header bg-light">
            <h6 class="mb-0"><i class="fas fa-tooth"></i> Treatment Items</h6>
        </div>
        <div class="card-body">
            @if (treatmentItems.Any())
            {
                <div class="table-responsive">
                    <table class="table table-sm table-striped">
                        <thead>
                            <tr>
                                <th>Item</th>
                                <th>Quantity</th>
                                <th>Price</th>
                                <th>Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in treatmentItems)
                            {
                                <tr>
                                    <td>@item.NameSnapshot</td>
                                    <td>@item.Quantity</td>
                                    <td>@item.PriceSnapshot.ToString("C")</td>
                                    <td><strong>@item.LineTotal.ToString("C")</strong></td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="table-active">
                                <td colspan="3" class="text-end"><strong>Total Cost:</strong></td>
                                <td><strong>@Model.TotalCost.ToString("C")</strong></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted mb-0">No treatment plan created yet.</p>
            }
        </div>
    </div>

    <!-- Payment Summary -->
    <div class="row mb-3">
        <div class="col-md-4">
            <div class="card text-center">
                <div class="card-body">
                    <h6 class="card-title text-muted">Total Cost</h6>
                    <h4 class="text-primary">@Model.TotalCost.ToString("C")</h4>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-center">
                <div class="card-body">
                    <h6 class="card-title text-muted">Amount Paid</h6>
                    <h4 class="text-success">@Model.AmountPaid.ToString("C")</h4>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-center">
                <div class="card-body">
                    <h6 class="card-title text-muted">Remaining</h6>
                    <h4 class="text-danger" id="remainingBalance">@Model.RemainingBalance.ToString("C")</h4>
                </div>
            </div>
        </div>
    </div>

    <!-- Payment Form -->
    <form id="paymentForm">
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.AppointmentId)
        @Html.HiddenFor(m => m.PatientId)
        @Html.HiddenFor(m => m.TotalCost)
        @Html.HiddenFor(m => m.AmountPaid)

        <div class="card mb-3">
            <div class="card-header bg-success text-white">
                <h6 class="mb-0"><i class="fas fa-money-bill-wave"></i> New Payment</h6>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="PaymentAmount" class="form-label">Payment Amount <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input type="number" step="0.01" min="0.01" max="@Model.RemainingBalance" 
                                   class="form-control" id="PaymentAmount" name="PaymentAmount" 
                                   value="@Model.RemainingBalance" required />
                        </div>
                        <small class="text-muted">Maximum: @Model.RemainingBalance.ToString("C")</small>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="PaymentDate" class="form-label">Payment Date</label>
                        <input type="datetime-local" class="form-control" id="PaymentDate" name="PaymentDate" 
                               value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" required />
                    </div>
                </div>
                <div class="mb-3">
                    <label for="Notes" class="form-label">Notes (Optional)</label>
                    <textarea class="form-control" id="Notes" name="Notes" rows="2" 
                              placeholder="Add any notes about this payment..."></textarea>
                </div>

                <!-- Quick Payment Buttons -->
                <div class="mb-3">
                    <label class="form-label">Quick Select:</label>
                    <div class="btn-group d-flex" role="group">
                        <button type="button" class="btn btn-outline-secondary" 
                                onclick="setPaymentAmount(@Model.RemainingBalance)">
                            Full Amount
                        </button>
                        <button type="button" class="btn btn-outline-secondary" 
                                onclick="setPaymentAmount(@(Model.RemainingBalance / 2))">
                            50%
                        </button>
                        <button type="button" class="btn btn-outline-secondary" 
                                onclick="setPaymentAmount(@(Model.RemainingBalance / 4))">
                            25%
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Payment History -->
        @if (paymentHistory.Any())
        {
            <div class="card">
                <div class="card-header bg-light">
                    <h6 class="mb-0"><i class="fas fa-history"></i> Payment History</h6>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Amount</th>
                                    <th>Notes</th>
                                    <th>By</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var payment in paymentHistory)
                                {
                                    <tr>
                                        <td>@payment.PaymentDate.ToString("MMM dd, yyyy hh:mm tt")</td>
                                        <td><strong>@payment.Amount.ToString("C")</strong></td>
                                        <td>@payment.Notes</td>
                                        <td>@payment.CreatedBy</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    </form>
</div>

<div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
        <i class="fas fa-times"></i> Cancel
    </button>
    <button type="button" class="btn btn-success" onclick="processPayment()">
        <i class="fas fa-check"></i> Process Payment
    </button>
</div>

<script>
    function setPaymentAmount(amount) {
        $('#PaymentAmount').val(amount.toFixed(2));
    }

    function processPayment() {
        const form = $('#paymentForm');
        const paymentAmount = parseFloat($('#PaymentAmount').val());
        const maxAmount = @Model.RemainingBalance;

        if (paymentAmount <= 0) {
            showNotification('Payment amount must be greater than zero.', 'error');
            return;
        }

        if (paymentAmount > maxAmount) {
            showNotification(`Payment amount cannot exceed remaining balance of ${maxAmount.toFixed(2)}.`, 'error');
            return;
        }

        $.ajax({
            url: '@Url.Action("ProcessPaymentWithAudit", "Reception")',
            type: 'POST',
            data: form.serialize(),
            success: function (response) {
                if (response.success) {
                    showNotification(response.message, 'success');
                    $('#paymentModal').modal('hide');
                    setTimeout(function () {
                        location.reload();
                    }, 1500);
                } else {
                    showNotification(response.message, 'error');
                }
            },
            error: function () {
                showNotification('An error occurred while processing the payment.', 'error');
            }
        });
    }

    function showNotification(message, type) {
        const alertClass = type === 'success' ? 'alert-success' : 'alert-danger';
        const notification = `
            <div class="alert ${alertClass} alert-dismissible fade show position-fixed" 
                 style="top: 20px; right: 20px; z-index: 9999;" role="alert">
                ${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        `;
        $('body').append(notification);
        setTimeout(function () {
            $('.alert').fadeOut('slow', function () {
                $(this).remove();
            });
        }, 3000);
    }
</script>
