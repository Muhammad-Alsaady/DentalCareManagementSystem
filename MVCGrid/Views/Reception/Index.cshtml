@using DentalManagementSystem.Models
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer


@using Microsoft.AspNetCore.Mvc.Localization
@model List<PatientAppointmentViewModel>

@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["Title"];
}

<div class="container-fluid mt-4">
    <!-- Header -->
    <div class="row mb-3">
        <div class="col-md-12">
            <h2><i class="fas fa-desktop"></i> @Localizer["PageTitle"]</h2>
            <p class="text-muted">@Localizer["PageSubtitle"]</p>
        </div>
    </div>

    <!-- Status Tabs -->
    <ul class="nav nav-tabs mb-3" id="receptionTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="scheduled-tab" data-bs-toggle="tab" data-bs-target="#scheduled" type="button">
                <i class="fas fa-calendar-check"></i> Scheduled (@Model.Count(m => m.Status == "Scheduled" || m.Status == "Notified"))
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="completed-tab" data-bs-toggle="tab" data-bs-target="#completed" type="button">
                <i class="fas fa-check-circle"></i> Ready for Payment
            </button>
        </li>
    </ul>

    <!-- Tab Content -->
    <div class="tab-content" id="receptionTabsContent">
        <!-- Scheduled Patients Tab -->
        <div class="tab-pane fade show active" id="scheduled" role="tabpanel">
            @if (Model.Any(m => m.Status == "Scheduled" || m.Status == "Notified"))
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Patient Name</th>
                                <th>Phone</th>
                                <th>Time</th>
                                <th>Status</th>
                                <th>Notes</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var appointment in Model.Where(m => m.Status == "Scheduled" || m.Status == "Notified").OrderBy(m => m.AppointmentDate))
                            {
                                <tr>
                                    <td><strong>@appointment.PatientName</strong></td>
                                    <td>@appointment.PhoneNumber</td>
                                    <td>@appointment.AppointmentDate.ToString("hh:mm tt")</td>
                                    <td><span class="badge @GetStatusBadge(appointment.Status)">@appointment.Status</span></td>
                                    <td>@appointment.Notes</td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <button type="button" class="btn btn-info" onclick="showAppointmentDetails('@appointment.Id')" title="Details">
                                                <i class="fas fa-info-circle"></i>
                                            </button>
                                            <button type="button" class="btn btn-success" onclick="sendToDoctor('@appointment.Id')" title="Send to Doctor">
                                                <i class="fas fa-user-md"></i>
                                            </button>
                                            <button type="button" class="btn btn-outline-primary" onclick="viewPatientHistory('@appointment.Id')" title="Patient History">
                                                <i class="fas fa-history"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <i class="fas fa-info-circle"></i> No scheduled appointments for today.
                </div>
            }
        </div>

        <!-- Appointments Table -->
        <div class="row">
            <div class="col-md-12">
                <div class="card shadow-sm">
                    <div class="card-header bg-primary text-white">
                        <h5 class="card-title mb-0">
                            <i class="fas fa-list"></i> @(Localizer["AppointmentsHeader"].Value + " - " + DateTime.Today.ToString("dddd, MMMM dd, yyyy"))
                        </h5>
                    </div>
                    <div class="card-body">
                        @if (Model.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-striped table-hover">
                                    <thead class="table-dark">
                                        <tr>
                                            <th>@Localizer["PatientName"]</th>
                                            <th>@Localizer["Phone"]</th>
                                            <th>@Localizer["AppointmentTime"]</th>
                                            <th>@Localizer["Status"]</th>
                                            <th>@Localizer["Notes"]</th>
                                            <th>@Localizer["Actions"]</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var appointment in Model)
                                        {
                                            <tr>
                                                <td>@appointment.PatientName</td>
                                                <td>@appointment.PhoneNumber</td>
                                                <td>@appointment.AppointmentDate.ToString("hh:mm tt")</td>
                                                <td>
                                                    <span class="badge @GetStatusBadge(appointment.Status)">
                                                        @appointment.Status
                                                    </span>
                                                </td>
                                                <td>@(appointment.Notes?.Length > 50 ? appointment.Notes.Substring(0, 50) + "..." : appointment.Notes)</td>
                                                <td>
@*                                                     <div class="btn-group btn-group-sm">
                                                        <!-- Treatment Plan Button -->
                                                        @if (appointment.Status == "Scheduled" || appointment.Status == "Notified")
                                                        {
                                                            <button class="btn btn-success" onclick="showTreatmentPlan('@appointment.Id')"
                                                                    title="@Localizer["TreatmentButton"]">
                                                                <i class="fas fa-stethoscope"></i> @Localizer["TreatmentButton"]
                                                            </button>
                                                        }
                                                        else if (appointment.Status == "UnderTreatment")
                                                        {
                                                            <button class="btn btn-warning" onclick="showPayment('@appointment.Id')"
                                                                    title="@Localizer["PaymentButton"]">
                                                                <i class="fas fa-money-bill-wave"></i> @Localizer["PaymentButton"]
                                                            </button>
                                                        }

                                                        <!-- View Details Button -->
                                                        <button class="btn btn-info" onclick="showAppointmentDetails('@appointment.Id')">
                                                            <i class="fas fa-eye"></i>
                                                        </button>
                                                    </div>
 *@                                           
                                                  
                                                    <div class="btn-group btn-group-sm">
                                                        @if (appointment.Status == "Scheduled" || appointment.Status == "Notified")
                                                        {
                                                            <button class="btn btn-success" onclick="showTreatmentPlan('@appointment.Id')">
                                                                <i class="fas fa-stethoscope"></i> Create Treatment
                                                            </button>
                                                        }
                                                        else if (appointment.Status == "UnderTreatment" || appointment.HasTreatmentPlan)
                                                        {
                                                            <button class="btn btn-warning" onclick="showPayment('@appointment.Id')">
                                                                <i class="fas fa-money-bill-wave"></i> Process Payment
                                                            </button>
                                                        }

                                                        <button class="btn btn-info" onclick="showAppointmentDetails('@appointment.Id')">
                                                            <i class="fas fa-eye"></i>
                                                        </button>
                                                    </div>
                                                </td>
                                            
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-info text-center">
                                <i class="fas fa-info-circle"></i>
                                @Localizer["NoAppointments"]
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- NO LOCAL MODAL - Using Global Modal from _Layout -->

@section Scripts {
        <script>
            $(document).ready(function () {
                // Listen for modal success to reload page
                $(document).on('modalSuccess', function(event, response) {
                    console.log('Treatment plan or payment saved successfully');
                    setTimeout(() => location.reload(), 1000);
                });
            });

            function sendToDoctor(appointmentId) {
                if (confirm('Are you sure you want to send this patient to the doctor?')) {
                    $.ajax({
                        url: '@Url.Action("SendToDoctor", "PatientAppointment")',
                        type: 'POST',
                        data: {
                            id: appointmentId,
                            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function (response) {
                            if (response.success) {
                                UIHelpers.showNotification(response.message, 'success');
                                setTimeout(() => location.reload(), 1500);
                            } else {
                                UIHelpers.showNotification(response.message, 'error');
                            }
                        },
                        error: function () {
                            UIHelpers.showNotification('An error occurred.', 'error');
                        }
                    });
                }
            }

            function showTreatmentPlan(appointmentId) {
                UIHelpers.loadModal(
                    '@Url.Action("GetTreatmentPlanForm", "Reception")?appointmentId=' + appointmentId,
                    'Create Treatment Plan'
                );
            }

            function showPayment(appointmentId) {
                UIHelpers.loadModal(
                    '@Url.Action("GetPaymentForm", "Reception")?appointmentId=' + appointmentId,
                    'Process Payment'
                );
            }

            function showAppointmentDetails(appointmentId) {
                UIHelpers.loadModal(
                    '@Url.Action("GetAppointmentDetails", "Reception")?appointmentId=' + appointmentId,
                    '@Localizer["ModalDetailsTitle"]'
                );
            }

            function viewPatientHistory(appointmentId) {
                window.location.href = '@Url.Action("PatientDetails", "Reception")?id=' + appointmentId;
            }
        </script>
}

@functions {
    string GetStatusBadge(string status)
    {
        return status switch
        {
            "Scheduled" => "bg-primary",
            "Notified" => "bg-info",
            "InProgress" => "bg-warning",
            "Completed" => "bg-success",
            "Cancelled" => "bg-danger",
            "NoShow" => "bg-secondary",
            _ => "bg-secondary"
        };
    }
}
