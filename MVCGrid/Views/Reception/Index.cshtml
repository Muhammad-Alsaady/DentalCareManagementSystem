@using DentalManagementSystem.Models
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@using Microsoft.AspNetCore.Mvc.Localization
@model List<PatientAppointmentViewModel>

@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["Title"];
}

<div class="container-fluid mt-4">
    <!-- Header -->
    <div class="row mb-3">
        <div class="col-md-12">
            <h2><i class="fas fa-desktop"></i> @Localizer["PageTitle"]</h2>
            <p class="text-muted">@Localizer["PageSubtitle"]</p>
        </div>
    </div>

    <!-- Status Tabs -->
    <ul class="nav nav-tabs mb-3" id="receptionTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="scheduled-tab" data-bs-toggle="tab" data-bs-target="#scheduled" type="button">
                <i class="fas fa-calendar-check"></i> Scheduled (@Model.Count(m => m.Status == "Scheduled" || m.Status == "Notified"))
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="completed-tab" data-bs-toggle="tab" data-bs-target="#completed" type="button">
                <i class="fas fa-check-circle"></i> Ready for Payment
            </button>
        </li>
    </ul>

    <!-- Tab Content -->
    <div class="tab-content" id="receptionTabsContent">
        <!-- Scheduled Patients Tab -->
        <div class="tab-pane fade show active" id="scheduled" role="tabpanel">
            @if (Model.Any(m => m.Status == "Scheduled" || m.Status == "Notified"))
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Patient Name</th>
                                <th>Phone</th>
                                <th>Time</th>
                                <th>Status</th>
                                <th>Notes</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var appointment in Model.Where(m => m.Status == "Scheduled" || m.Status == "Notified").OrderBy(m => m.AppointmentDate))
                            {
                                <tr>
                                    <td><strong>@appointment.PatientName</strong></td>
                                    <td>@appointment.PhoneNumber</td>
                                    <td>@appointment.AppointmentDate.ToString("hh:mm tt")</td>
                                    <td><span class="badge @GetStatusBadge(appointment.Status)">@appointment.Status</span></td>
                                    <td>@appointment.Notes</td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <button type="button" class="btn btn-info" onclick="showAppointmentDetails('@appointment.Id')" title="Details">
                                                <i class="fas fa-info-circle"></i>
                                            </button>
                                            <button type="button" class="btn btn-success" onclick="sendToDoctor('@appointment.Id')" title="Send to Doctor">
                                                <i class="fas fa-user-md"></i>
                                            </button>
                                            <button type="button" class="btn btn-outline-primary" onclick="viewPatientHistory('@appointment.Id')" title="Patient History">
                                                <i class="fas fa-history"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <i class="fas fa-info-circle"></i> No scheduled appointments for today.
                </div>
            }
        </div>

        <!-- Completed Patients Tab (Ready for Payment) -->
        <div class="tab-pane fade" id="completed" role="tabpanel">
            @{
                var completedAppointments = Model.Where(m => m.Status == "Completed" || m.Status == "InProgress").ToList();
            }
            @if (completedAppointments.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Patient Name</th>
                                <th>Phone</th>
                                <th>Time</th>
                                <th>Status</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var appointment in completedAppointments.OrderBy(m => m.AppointmentDate))
                            {
                                <tr>
                                    <td><strong>@appointment.PatientName</strong></td>
                                    <td>@appointment.PhoneNumber</td>
                                    <td>@appointment.AppointmentDate.ToString("hh:mm tt")</td>
                                    <td><span class="badge @GetStatusBadge(appointment.Status)">@appointment.Status</span></td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <button type="button" class="btn btn-primary" onclick="showPaymentModal('@appointment.Id')" title="Process Payment">
                                                <i class="fas fa-dollar-sign"></i> Payment
                                            </button>
                                            <button type="button" class="btn btn-outline-info" onclick="viewPatientHistory('@appointment.Id')" title="Patient History">
                                                <i class="fas fa-history"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <i class="fas fa-info-circle"></i> No completed appointments waiting for payment.
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal for forms -->
<div class="modal fade" id="crudModal" tabindex="-1" aria-labelledby="crudModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="crudModalLabel">@Localizer["ModalDetailsTitle"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="crudModalBody"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let crudModal;

        $(document).ready(function () {
            crudModal = new bootstrap.Modal(document.getElementById('crudModal'));
        });

        function sendToDoctor(appointmentId) {
            if (confirm('Are you sure you want to send this patient to the doctor?')) {
                $.ajax({
                    url: '@Url.Action("SendToDoctor", "PatientAppointment")',
                    type: 'POST',
                    data: {
                        id: appointmentId,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function (response) {
                        if (response.success) {
                            showNotification(response.message, 'success');
                            setTimeout(() => location.reload(), 1500);
                        } else {
                            showNotification(response.message, 'error');
                        }
                    },
                    error: function () {
                        showNotification('An error occurred.', 'error');
                    }
                });
            }
        }

        function showPaymentModal(appointmentId) {
            $.ajax({
                url: '@Url.Action("GetPaymentModal", "Reception")',
                type: 'GET',
                data: { appointmentId: appointmentId },
                success: function (data) {
                    $('#crudModalBody').html(data);
                    $('#crudModalLabel').text('Process Payment');
                    crudModal.show();
                },
                error: function () {
                    showNotification('Error loading payment form.', 'error');
                }
            });
        }

        function showAppointmentDetails(appointmentId) {
            $.get('@Url.Action("GetAppointmentDetails", "Reception")?appointmentId=' + appointmentId)
                .done(function (data) {
                    $('#crudModalBody').html(data);
                    $('#crudModalLabel').text('@Localizer["ModalDetailsTitle"]');
                    crudModal.show();
                })
                .fail(function (xhr, status, error) {
                    console.error('Error loading details:', error);
                    showNotification('Error loading details.', 'error');
                });
        }

        function viewPatientHistory(appointmentId) {
            window.location.href = '@Url.Action("PatientDetails", "Reception")?id=' + appointmentId;
        }

        function showNotification(message, type) {
            const alertClass = type === 'success' ? 'alert-success' : 'alert-danger';
            const notification = `
                <div class="alert ${alertClass} alert-dismissible fade show position-fixed" 
                     style="top: 20px; right: 20px; z-index: 9999;" role="alert">
                    ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            `;
            $('body').append(notification);
            setTimeout(() => $('.alert').fadeOut('slow', function() { $(this).remove(); }), 3000);
        }
    </script>
}

@functions {
    string GetStatusBadge(string status)
    {
        return status switch
        {
            "Scheduled" => "bg-primary",
            "Notified" => "bg-info",
            "InProgress" => "bg-warning",
            "Completed" => "bg-success",
            "Cancelled" => "bg-danger",
            "NoShow" => "bg-secondary",
            _ => "bg-secondary"
        };
    }
}
