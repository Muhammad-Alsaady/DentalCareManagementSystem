@model DentalCareManagmentSystem.Application.Interfaces.PaymentSummaryDto

<form id="paymentForm" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="AppointmentId" value="@Model.AppointmentId" />
    <input type="hidden" name="PatientId" value="@Model.PatientId" />

    <div class="modal-header bg-primary text-white">
        <h5 class="modal-title">
            <i class="fas fa-dollar-sign"></i> Process Payment - @Model.PatientName
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
    </div>

    <div class="modal-body">
        @if (!Model.TreatmentItems.Any())
        {
            <div class="alert alert-warning">
                <i class="fas fa-exclamation-triangle"></i> 
                <strong>No Treatment Plan Found!</strong>
                <p>The doctor needs to create a treatment plan before payment can be processed.</p>
            </div>
        }
        else
        {
            <!-- Treatment Items Selected by Doctor -->
            <div class="card mb-3">
                <div class="card-header bg-light">
                    <h6 class="mb-0"><i class="fas fa-tooth"></i> Treatment Plan Items (Selected by Doctor)</h6>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-sm table-striped mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 50%">Service</th>
                                    <th style="width: 15%" class="text-center">Price</th>
                                    <th style="width: 15%" class="text-center">Qty</th>
                                    <th style="width: 20%" class="text-end">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.TreatmentItems)
                                {
                                    <tr>
                                        <td>@item.Name</td>
                                        <td class="text-center">$@item.Price.ToString("N2")</td>
                                        <td class="text-center">@item.Quantity</td>
                                        <td class="text-end"><strong>$@item.LineTotal.ToString("N2")</strong></td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="table-light">
                                <tr>
                                    <td colspan="3" class="text-end"><strong>Total Cost:</strong></td>
                                    <td class="text-end"><strong class="text-primary">$@Model.TotalCost.ToString("N2")</strong></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Payment Summary Cards -->
            <div class="row mb-3">
                <div class="col-md-4">
                    <div class="card text-center border-primary">
                        <div class="card-body">
                            <h6 class="card-title text-muted mb-1">Total Cost</h6>
                            <h3 class="text-primary mb-0">$@Model.TotalCost.ToString("N2")</h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card text-center border-success">
                        <div class="card-body">
                            <h6 class="card-title text-muted mb-1">Already Paid</h6>
                            <h3 class="text-success mb-0">$@Model.TotalPaid.ToString("N2")</h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card text-center @(Model.RemainingBalance > 0 ? "border-danger" : "border-success")">
                        <div class="card-body">
                            <h6 class="card-title text-muted mb-1">Remaining</h6>
                            <h3 class="@(Model.RemainingBalance > 0 ? "text-danger" : "text-success") mb-0">
                                $@Model.RemainingBalance.ToString("N2")
                            </h3>
                        </div>
                    </div>
                </div>
            </div>

            @if (Model.IsFullyPaid)
            {
                <div class="alert alert-success text-center">
                    <i class="fas fa-check-circle fa-2x mb-2"></i>
                    <h5>Payment Complete!</h5>
                    <p class="mb-0">This appointment has been fully paid.</p>
                </div>
            }
            else
            {
                <!-- Payment Input Form -->
                <div class="card mb-3">
                    <div class="card-header bg-success text-white">
                        <h6 class="mb-0"><i class="fas fa-money-bill-wave"></i> Enter Payment</h6>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <label class="form-label">Amount to Pay <span class="text-danger">*</span></label>
                                <input type="number" name="Amount" id="amountInput" class="form-control form-control-lg" 
                                       value="@Model.RemainingBalance" min="0.01" max="@Model.RemainingBalance" 
                                       step="0.01" required />
                                <small class="text-muted">Maximum: $@Model.RemainingBalance.ToString("N2")</small>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Discount %</label>
                                <input type="number" name="DiscountPercentage" id="discountInput" class="form-control" 
                                       value="0" min="0" max="100" step="0.1" />
                                <small class="text-muted">Optional</small>
                            </div>
                        </div>
                        <div class="row mt-3">
                            <div class="col-md-12">
                                <label class="form-label">Notes (Optional)</label>
                                <textarea name="Notes" class="form-control" rows="2" 
                                          placeholder="Payment notes..."></textarea>
                            </div>
                        </div>

                        <!-- Auto-Calculated Remainder Display -->
                        <div class="mt-3 p-3 bg-light rounded">
                            <div class="row">
                                <div class="col-6">
                                    <strong>Amount Entering:</strong>
                                </div>
                                <div class="col-6 text-end">
                                    <span id="displayAmount" class="text-primary">$@Model.RemainingBalance.ToString("N2")</span>
                                </div>
                            </div>
                            <div class="row mt-2">
                                <div class="col-6">
                                    <strong>New Remainder:</strong>
                                </div>
                                <div class="col-6 text-end">
                                    <span id="newRemainder" class="text-danger fw-bold">$0.00</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- Payment History -->
            @if (Model.PaymentHistory.Any())
            {
                <div class="card">
                    <div class="card-header bg-light">
                        <h6 class="mb-0"><i class="fas fa-history"></i> Payment History</h6>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-sm mb-0">
                                <thead>
                                    <tr>
                                        <th>Date</th>
                                        <th>Amount</th>
                                        <th>Processed By</th>
                                        <th>Notes</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var payment in Model.PaymentHistory)
                                    {
                                        <tr>
                                            <td>@payment.PaymentDate.ToString("yyyy-MM-dd HH:mm")</td>
                                            <td class="text-success fw-bold">$@payment.Amount.ToString("N2")</td>
                                            <td>@payment.ProcessedBy</td>
                                            <td>@payment.Notes</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
        }
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
            <i class="fas fa-times"></i> Close
        </button>
        @if (!Model.IsFullyPaid && Model.TreatmentItems.Any())
        {
            <button type="submit" class="btn btn-success">
                <i class="fas fa-check"></i> Process Payment
            </button>
        }
    </div>
</form>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Auto-calculate remainder when amount changes
            $('#amountInput').on('input', function() {
                updateRemainder();
            });

            function updateRemainder() {
                const totalRemaining = @Model.RemainingBalance;
                const amountEntering = parseFloat($('#amountInput').val()) || 0;
                const newRemainder = totalRemaining - amountEntering;

                $('#displayAmount').text('$' + amountEntering.toFixed(2));
                $('#newRemainder').text('$' + Math.max(0, newRemainder).toFixed(2));

                if (newRemainder <= 0) {
                    $('#newRemainder').removeClass('text-danger').addClass('text-success');
                } else {
                    $('#newRemainder').removeClass('text-success').addClass('text-danger');
                }
            }

            // Initialize on load
            updateRemainder();
        });

        // Form submission
        $('#paymentForm').on('submit', function(e) {
            e.preventDefault();

            const amount = parseFloat($('#amountInput').val());
            if (amount <= 0) {
                alert('Please enter a valid payment amount');
                return false;
            }

            if (amount > @Model.RemainingBalance) {
                alert('Payment amount cannot exceed remaining balance');
                return false;
            }

            const formData = $(this).serialize();

            $.ajax({
                url: '@Url.Action("ProcessPayment", "Reception")',
                type: 'POST',
                data: formData,
                success: function(response) {
                    if (response.success) {
                        UIHelpers.showNotification(response.message, 'success');
                        bootstrap.Modal.getInstance(document.getElementById('globalModal')).hide();
                        
                        // Reload to show updated data
                        setTimeout(() => location.reload(), 1000);
                    } else {
                        UIHelpers.showNotification(response.message || 'Error processing payment', 'error');
                    }
                },
                error: function(xhr) {
                    console.error('Error:', xhr);
                    UIHelpers.showNotification('An error occurred while processing payment', 'error');
                }
            });

            return false;
        });
    </script>
}
